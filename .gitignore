*.log
*.pid
.scratch/
.ade/terraform/

# Terraform working files. State names the account, the operator's IP and any
# secret a resource carries; the provider cache is hundreds of MB of binaries.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

node_modules/
internal/web/dist/
app/dist/
app/out/
extension/web-ext-artifacts/
*.test

# Local environment. Never committed.
.env
.DS_Store
tmp/
shell/
# Role and agent prompts: they name people and employers, so they live in
# ade-private. Copy them in with `make private`.
internal/roles/defaults/*.md
internal/agents/defaults/*.md

# A browser fetched for screenshots in a Linux container: 680 MB, and
# the wrong architecture for anything but that container.
tools/shots/chromium/
tools/shots/chromium
