+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+.monaco-workbench .title-status {
+	display: flex;
+	align-items: center;
+	height: 100%;
+	padding: 0 4px;
+	cursor: pointer;
+}
+
+.monaco-workbench .title-status-pill {
+	display: inline-flex;
+	align-items: center;
+	gap: 5px;
+	padding: 1px 9px;
+	border-radius: 10px;
+	font-size: 11px;
+	line-height: 16px;
+	white-space: nowrap;
+	/* Colour says the agent wants you. A run reporting itself every second
+	   is ambient, and as loud as the session's name it is noise. */
+	background: transparent;
+	color: var(--vscode-descriptionForeground);
+}
+
+.monaco-workbench .title-status-pill.warn {
+	background: var(--vscode-statusBarItem-warningBackground);
+	color: var(--vscode-statusBarItem-warningForeground);
+}
