+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { $, reset } from '../../../../base/browser/dom.js';
+import { renderLabelWithIcons } from '../../../../base/browser/ui/iconLabel/iconLabels.js';
+import { BaseActionViewItem, IBaseActionViewItemOptions } from '../../../../base/browser/ui/actionbar/actionViewItems.js';
+import { IAction } from '../../../../base/common/actions.js';
+import { Emitter } from '../../../../base/common/event.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { localize2 } from '../../../../nls.js';
+import { IActionViewItemService } from '../../../../platform/actions/browser/actionViewItemService.js';
+import { Action2, MenuId, registerAction2 } from '../../../../platform/actions/common/actions.js';
+import { CommandsRegistry, ICommandService } from '../../../../platform/commands/common/commands.js';
+import { ContextKeyExpr, IContextKeyService, RawContextKey } from '../../../../platform/contextkey/common/contextkey.js';
+import { IInstantiationService, ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import './media/titleStatus.css';
+
+// A status an extension puts in the title bar: `workbench.titleBar.setStatus`
+// with { id, text, tooltip?, command?, warn? }, or { id } alone to clear it.
+interface ITitleStatus {
+	readonly id: string;
+	readonly text?: string;
+	readonly tooltip?: string;
+	readonly command?: string;
+	readonly warn?: boolean;
+}
+
+const ACTION_ID = 'workbench.titleBar.status';
+const HasTitleStatus = new RawContextKey<boolean>('titleBarStatus', false);
+const statuses = new Map<string, ITitleStatus>();
+const onDidChange = new Emitter<void>();
+
+CommandsRegistry.registerCommand('workbench.titleBar.setStatus', (_accessor: ServicesAccessor, status: ITitleStatus) => {
+	if (!status?.id) {
+		return;
+	}
+	if (status.text) {
+		statuses.set(status.id, status);
+	} else {
+		statuses.delete(status.id);
+	}
+	onDidChange.fire();
+});
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: ACTION_ID,
+			title: localize2('titleStatus', "Status"),
+			menu: [{ id: MenuId.TitleBar, group: 'navigation', order: -10, when: ContextKeyExpr.has('titleBarStatus') }]
+		});
+	}
+
+	override async run(accessor: ServicesAccessor): Promise<void> {
+		const first = [...statuses.values()].find(s => s.command);
+		if (first?.command) {
+			await accessor.get(ICommandService).executeCommand(first.command);
+		}
+	}
+});
+
+class TitleStatusItem extends BaseActionViewItem {
+	constructor(action: IAction, options: IBaseActionViewItemOptions) {
+		super(undefined, action, options);
+		this._register(onDidChange.event(() => this.draw()));
+	}
+
+	override render(container: HTMLElement): void {
+		super.render(container);
+		container.classList.add('title-status');
+		this.draw();
+	}
+
+	private draw(): void {
+		if (!this.element) {
+			return;
+		}
+		reset(this.element, ...[...statuses.values()].map(status => {
+			const pill = $('span.title-status-pill', { title: status.tooltip ?? status.text ?? '' }, ...renderLabelWithIcons(status.text ?? ''));
+			pill.classList.toggle('warn', Boolean(status.warn));
+			return pill;
+		}));
+	}
+}
+
+class TitleStatusContribution extends Disposable implements IWorkbenchContribution {
+	static readonly ID = 'workbench.contrib.titleStatus';
+
+	constructor(
+		@IActionViewItemService actionViewItemService: IActionViewItemService,
+		@IInstantiationService instantiationService: IInstantiationService,
+		@IContextKeyService contextKeyService: IContextKeyService,
+	) {
+		super();
+		const has = HasTitleStatus.bindTo(contextKeyService);
+		this._register(onDidChange.event(() => has.set(statuses.size > 0)));
+		this._register(actionViewItemService.register(MenuId.TitleBar, ACTION_ID, (action, options) =>
+			instantiationService.createInstance(TitleStatusItem, action, options)));
+	}
+}
+
+registerWorkbenchContribution2(TitleStatusContribution.ID, TitleStatusContribution, WorkbenchPhase.AfterRestored);
