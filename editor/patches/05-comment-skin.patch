diff --git a/src/vs/workbench/contrib/comments/browser/media/review.css b/src/vs/workbench/contrib/comments/browser/media/review.css
index 1d42ac39..35fb2df9 100644
--- a/src/vs/workbench/contrib/comments/browser/media/review.css
+++ b/src/vs/workbench/contrib/comments/browser/media/review.css
@@ -627,3 +627,29 @@ div.preview.inline .monaco-editor .comment-range-glyph {
 .monaco-editor.inline-comment .margin-view-overlays .dirty-diff-glyph {
 	margin-left: 25px;
 }
+
+/* ADE: the thread's context and each comment's author are data on the widget,
+   so a skin can tell the agent's finding from a reply without touching logic. */
+.review-widget[data-thread-context^="adeOpen"] .head {
+	box-shadow: inset 3px 0 0 var(--vscode-charts-orange);
+}
+
+.review-widget[data-thread-context^="adeResolved"] .head {
+	box-shadow: inset 3px 0 0 var(--vscode-charts-green);
+}
+
+.review-widget .body .review-comment[data-author="you"] {
+	background: color-mix(in srgb, var(--vscode-charts-blue) 10%, transparent);
+}
+
+.review-widget .body .review-comment:not([data-author="you"]) .review-comment-contents .author {
+	color: var(--vscode-charts-orange);
+}
+
+.monaco-editor .comment-range-glyph.thread-ctx-adeopen:before {
+	background: var(--vscode-charts-orange);
+}
+
+.monaco-editor .comment-range-glyph.thread-ctx-aderesolved:before {
+	background: var(--vscode-charts-green);
+}
