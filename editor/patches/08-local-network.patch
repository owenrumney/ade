diff --git a/src/vs/code/electron-main/localNetwork.ts b/src/vs/code/electron-main/localNetwork.ts
new file mode 100644
index 00000000..21b2ce4e
--- /dev/null
+++ b/src/vs/code/electron-main/localNetwork.ts
@@ -0,0 +1,79 @@
+/*---------------------------------------------------------------------------------------------
+ *  ADE: macOS asks about Local Network only when the app's own process dials the LAN.
+ *--------------------------------------------------------------------------------------------*/
+
+import { execFile } from 'child_process';
+import { promises as fs } from 'fs';
+import { connect } from 'net';
+import { homedir } from 'os';
+import { join } from 'path';
+
+export interface IDialTarget {
+	readonly host: string;
+	readonly port: number;
+}
+
+const dialWait = 3000;
+const resolveWait = 2000;
+
+/**
+ * Dials each machine bookmarked in ~/.ade/settings.json once, from this process.
+ * Everything ADE starts inherits the verdict; without this dial macOS never asks.
+ */
+export async function askForLocalNetwork(): Promise<void> {
+	let raw: string;
+	try {
+		raw = await fs.readFile(join(homedir(), '.ade', 'settings.json'), 'utf8');
+	} catch {
+		return;
+	}
+	const targets = await Promise.all(bookmarkedHosts(raw).map(resolveTarget));
+	await Promise.all(targets.filter(t => !isLoopback(t.host)).map(dial));
+}
+
+export function bookmarkedHosts(settings: string): string[] {
+	try {
+		const parsed = JSON.parse(settings) as { hosts?: { name?: unknown }[] };
+		return (parsed.hosts ?? []).map(h => h.name).filter((n): n is string => typeof n === 'string' && n !== '');
+	} catch {
+		return [];
+	}
+}
+
+/** The host and port from `ssh -G` output, so an ssh alias dials what ssh would. */
+export function parseSshConfig(output: string, fallback: IDialTarget): IDialTarget {
+	let host = fallback.host;
+	let port = fallback.port;
+	for (const line of output.split('\n')) {
+		const [key, value] = line.trim().split(/\s+/, 2);
+		if (key === 'hostname' && value) {
+			host = value;
+		} else if (key === 'port' && Number(value) > 0) {
+			port = Number(value);
+		}
+	}
+	return { host, port };
+}
+
+export function isLoopback(host: string): boolean {
+	return host === 'localhost' || host === '::1' || host.startsWith('127.');
+}
+
+function resolveTarget(name: string): Promise<IDialTarget> {
+	const fallback = { host: name.slice(name.lastIndexOf('@') + 1), port: 22 };
+	return new Promise(resolve => {
+		execFile('ssh', ['-G', name], { timeout: resolveWait }, (err, stdout) => {
+			resolve(err ? fallback : parseSshConfig(stdout, fallback));
+		});
+	});
+}
+
+function dial(target: IDialTarget): Promise<void> {
+	return new Promise(resolve => {
+		const socket = connect({ host: target.host, port: target.port, timeout: dialWait });
+		const done = () => { socket.destroy(); resolve(); };
+		socket.once('connect', done);
+		socket.once('timeout', done);
+		socket.once('error', done);
+	});
+}
diff --git a/src/vs/code/test/node/localNetwork.test.ts b/src/vs/code/test/node/localNetwork.test.ts
new file mode 100644
index 00000000..1434b49a
--- /dev/null
+++ b/src/vs/code/test/node/localNetwork.test.ts
@@ -0,0 +1,34 @@
+/*---------------------------------------------------------------------------------------------
+ *  ADE: the Local Network trigger dials what ssh would, and never loopback.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../base/test/common/utils.js';
+import { bookmarkedHosts, isLoopback, parseSshConfig } from '../../electron-main/localNetwork.js';
+
+suite('ADE Local Network trigger', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('reads the bookmarked hosts', () => {
+		assert.deepStrictEqual(bookmarkedHosts('{"hosts":[{"name":"pi@pi5.local"},{"label":"no name"},{"name":"bigboy"}]}'), ['pi@pi5.local', 'bigboy']);
+		assert.deepStrictEqual(bookmarkedHosts('{}'), []);
+		assert.deepStrictEqual(bookmarkedHosts('not json'), []);
+	});
+
+	test('an ssh alias dials its real host and port', () => {
+		const output = 'user pi\nhostname 172.16.0.107\nport 2222\nidentityfile ~/.ssh/id_ed25519\n';
+		assert.deepStrictEqual(parseSshConfig(output, { host: 'pi5', port: 22 }), { host: '172.16.0.107', port: 2222 });
+	});
+
+	test('without ssh -G the name after the user is dialled on 22', () => {
+		assert.deepStrictEqual(parseSshConfig('', { host: 'pi5.local', port: 22 }), { host: 'pi5.local', port: 22 });
+	});
+
+	test('loopback is skipped: only a LAN address makes macOS ask', () => {
+		assert.ok(isLoopback('localhost'));
+		assert.ok(isLoopback('127.0.0.1'));
+		assert.ok(isLoopback('::1'));
+		assert.ok(!isLoopback('pi5.local'));
+		assert.ok(!isLoopback('172.16.0.107'));
+	});
+});
