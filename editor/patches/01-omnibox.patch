+	// The omnibox: one row that hands what was typed to ade. A leading slash
+	// names one of ade's verbs; anything else is said to the agent.
+	private async getAdeRows(query: IPreparedQuery, token: CancellationToken): Promise<IAnythingQuickPickItem[]> {
+		// An empty box shows what it was last asked; a slash is the verbs' own.
+		const command = query.original ? 'ade.omnibox.rows' : 'ade.omnibox.recent';
+		if (query.original.startsWith('/') || !CommandsRegistry.getCommand(command)) {
+			return [];
+		}
+		const rows = await raceTimeout(this.commandService.executeCommand<AdeRow[]>(command, query.original), 400);
+		if (!rows || token.isCancellationRequested) {
+			return [];
+		}
+		return rows.map(row => ({
+			label: row.label,
+			description: row.description,
+			detail: row.detail,
+			alwaysShow: true,
+			iconClass: row.icon ? ThemeIcon.asClassName({ id: row.icon }) : undefined,
+			accept: () => this.commandService.executeCommand(row.command, ...(row.args ?? []))
+		}));
