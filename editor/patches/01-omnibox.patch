+		}
+		const verb = query.original.startsWith('/');
+		const text = verb ? query.original.slice(1).trim() : query.original;
+		const pick: IAnythingQuickPickItem = {
+			label: verb ? localize('adeVerb', "ade: {0}", text) : localize('adeAsk', "Ask ade: {0}", text),
+			description: verb ? localize('adeVerbDesc', "run the verb") : localize('adeAskDesc', "send to the agent"),
+			alwaysShow: true,
+			iconClass: ThemeIcon.asClassName(Codicon.sparkle),
+			buttons: verb ? undefined : [{ iconClass: ThemeIcon.asClassName(Codicon.zap), tooltip: localize('adeAnswerHere', "Answer here, without a turn") }],
+			accept: () => this.commandService.executeCommand('ade.omnibox', query.original),
+			trigger: () => {
+				this.answerInPlace(pick, query.original);
+				return TriggerAction.NO_ACTION;
+			}
+		};
+		return pick;
+	}
+
+	// The answer lands in the row's detail while the box stays open: a question
+	// one line long should not cost a turn in the chat.
+	private async answerInPlace(pick: IAnythingQuickPickItem, question: string): Promise<void> {
+		const picker = this.pickState.picker;
+		const redraw = () => {
+			if (picker) {
+				picker.items = [...picker.items];
+			}
+		};
+		pick.detail = localize('adeThinking', "thinking…");
+		redraw();
+		try {
+			const got = await this.commandService.executeCommand<{ answer?: string }>('ade.omnibox.answer', question);
+			pick.detail = got?.answer || localize('adeNoAnswer', "no answer");
+		} catch (err) {
+			pick.detail = String(err);
+		}
+		redraw();
+	}
+
